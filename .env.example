PORT=3000

# MySQL Database (XAMPP Default)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_bot

# Meta WhatsApp Cloud API
# Get these from developers.facebook.com
WHATSAPP_TOKEN=your_whatsapp_access_token
VERIFY_TOKEN=your_chosen_verify_token
